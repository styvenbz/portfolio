# Keystatic GitHub mode (production editing at /keystatic).
# Until these are set, Keystatic falls back to local mode.
NEXT_PUBLIC_GITHUB_REPO_OWNER=
NEXT_PUBLIC_GITHUB_REPO_NAME=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Signs the case-study unlock cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Case study passwords. NEVER put these in the CMS — src/content/ is committed.
# Per project: CASE_PASSWORD_<SLUG_IN_CAPS>, e.g. CASE_PASSWORD_INTERNAL_PLATFORM
# Shared fallback:
CASE_PASSWORD_DEFAULT=
